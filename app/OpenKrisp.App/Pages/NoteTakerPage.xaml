<Page x:Class="OpenKrisp.App.Pages.NoteTakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notes="using:OpenKrisp.Core.Notes"
    xmlns:local="using:OpenKrisp.App.Pages">
    <Grid Background="White" Padding="24,16,24,20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Meetings" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{x:Bind NotesVm.Status, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind NotesVm.Error, Mode=OneWay}" Foreground="DarkRed" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Record_Click" IsEnabled="{x:Bind NotesVm.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="28,14" MinWidth="150" AutomationProperties.Name="Start recording">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7C8;" FontSize="20"/><TextBlock Text="Record" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Button Grid.Column="2" Content="Stop and transcribe" Click="StopRecording_Click" Padding="20,14" IsEnabled="{x:Bind NotesVm.CanStop, Mode=OneWay}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox Header="Audio source" ItemsSource="{x:Bind NotesVm.AudioSources}" DisplayMemberPath="Name" SelectedItem="{x:Bind NotesVm.SelectedAudioSource, Mode=TwoWay}" IsEnabled="{x:Bind NotesVm.CanSetUp, Mode=OneWay}" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="Import audio" Click="ImportAudio_Click" IsEnabled="{x:Bind NotesVm.CanStart, Mode=OneWay}" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="Cancel processing" Click="CancelProcessing_Click" IsEnabled="{x:Bind NotesVm.CanCancel, Mode=OneWay}" VerticalAlignment="Bottom"/>
        </Grid>
        <Expander Grid.Row="2" Header="Recording settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RecordingTitleBox" Header="Title (optional)" PlaceholderText="A sentence title is generated after transcription"/>
                    <NumberBox Grid.Column="1" Header="Speakers (0 = auto)" Minimum="0" Maximum="20" ValueChanged="SpeakerCount_Changed" Value="2"/>
                    <ComboBox Grid.Column="2" Header="Type" SelectedIndex="{x:Bind NotesVm.NewKindIndex, Mode=TwoWay}"><ComboBoxItem Content="Meeting"/><ComboBoxItem Content="Lecture"/></ComboBox>
                </Grid>
                <TextBox Header="Tags" PlaceholderText="Project, course, topic" Text="{x:Bind NotesVm.NewTags, Mode=TwoWay}"/>
                <TextBlock Text="{x:Bind NotesVm.ModelStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock Text="Whistle: English, German, French, Spanish, Italian, Dutch and Polish. Audio and notes remain local." TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"/>
                <Button Content="Set up / load local models" Click="SetUpModels_Click" IsEnabled="{x:Bind NotesVm.CanSetUp, Mode=OneWay}"/>
            </StackPanel>
        </Expander>
        <Expander Grid.Row="3" Header="Live audio and detection" IsExpanded="{x:Bind NotesVm.IsRecording, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="440">
                <StackPanel Spacing="10">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Live audio and detection" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind NotesVm.ProcessingStep, Mode=OneWay}" TextWrapping="Wrap" />
                            <Grid x:Name="LevelTrack" Height="28" SizeChanged="LevelTrack_SizeChanged" Background="#202A30" CornerRadius="4"
                                  AutomationProperties.Name="Live audio peak meter, minus 60 to zero dBFS">
                                <Border x:Name="LevelFill" CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#22C55E" Offset="0" />
                                            <GradientStop Color="#84CC16" Offset="0.55" />
                                            <GradientStop Color="#FACC15" Offset="0.75" />
                                            <GradientStop Color="#F97316" Offset="0.9" />
                                            <GradientStop Color="#EF4444" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="HeldPeakMarker" Width="2" Background="White" HorizontalAlignment="Left" ToolTipService.ToolTip="Held peak (one second)" />
                                <Border x:Name="RmsFill" Height="3" Background="White" VerticalAlignment="Bottom" HorizontalAlignment="Left" Opacity="0.8" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="−60 dBFS" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="−40" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="−20" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="0 · clip" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>
                            <TextBlock Text="{x:Bind NotesVm.LevelText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind NotesVm.SpeechConfidenceText, Mode=OneWay}" />
                            <Grid x:Name="SpeechConfidenceTrack" Height="14" SizeChanged="LevelTrack_SizeChanged">
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind NotesVm.SpeechProbabilityPercent, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{x:Bind NotesVm.SpeechDetectionText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind NotesVm.TurnConfidenceText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind NotesVm.TurnDetectionText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Grid x:Name="TurnConfidenceTrack" Height="14" SizeChanged="LevelTrack_SizeChanged">
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind NotesVm.TurnProbabilityPercent, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Voice activity and thought completion follow the models automatically. Confidence updates from incoming audio; no sensitivity settings are required. The original recording is preserved."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind NotesVm.LiveStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <ListView x:Name="LiveTranscriptList" ItemsSource="{x:Bind NotesVm.LiveTurns, Mode=OneWay}" MaxHeight="180" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate x:DataType="notes:TranscriptTurn">
                            <StackPanel Spacing="5" Padding="0,6"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Speaker}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind TimeText}" Style="{StaticResource MutedTextStyle}"/></StackPanel><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23"/></StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <Grid Grid.Row="4" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox PlaceholderText="Search meetings and notes" Text="{x:Bind NotesVm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" PlaceholderText="Filter by tag" Text="{x:Bind NotesVm.TagFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ListView Grid.Row="2" ItemsSource="{x:Bind NotesVm.Transcripts, Mode=OneWay}" SelectedItem="{x:Bind NotesVm.SelectedTranscript, Mode=TwoWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate><DataTemplate x:DataType="notes:TranscriptCard"><StackPanel Padding="2,12" Spacing="6"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{x:Bind StartedText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{x:Bind Kind}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ContentControl Grid.Column="1" Content="{x:Bind NotesVm.SelectedTranscript, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="notes:TranscriptCard">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5"><TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind StartedText}" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                                <Button Grid.Column="1" Content="Summarize" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Id}" Click="Summarize_Click" IsEnabled="{x:Bind CanSummarize}" VerticalAlignment="Top"/>
                                <Button Grid.Column="2" Content="Export" Tag="{x:Bind Id}" Click="ExportNotes_Click" VerticalAlignment="Top"/>
                            </Grid>
                            <Pivot Grid.Row="1">
                                <PivotItem Header="Notes">
                                    <ScrollViewer><StackPanel Spacing="18" Padding="0,14,12,20">
                                        <TextBlock Text="{x:Bind SummaryStatus}" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="24"/>
                                        <TextBlock Text="✧  Key Points" FontSize="18" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{x:Bind KeyPoints}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnSpacing="12" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•"/><TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <ItemsControl ItemsSource="{x:Bind Topics}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="notes:NoteTopic"><StackPanel Spacing="8" Margin="0,0,0,14"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{x:Bind Points}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <StackPanel Spacing="12" Visibility="{x:Bind local:NoteTakerPage.VisibleWhen(HasDecisions)}">
                                            <TextBlock Text="Decisions" FontSize="18" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind Decisions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnSpacing="12" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•"/><TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                        <StackPanel Spacing="12" Visibility="{x:Bind local:NoteTakerPage.VisibleWhen(HasOpenQuestions)}">
                                            <TextBlock Text="Open questions" FontSize="18" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind OpenQuestions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnSpacing="12" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•"/><TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                        <StackPanel Spacing="12" Visibility="{x:Bind local:NoteTakerPage.VisibleWhen(HasRisks)}">
                                            <TextBlock Text="Risks and blockers" FontSize="18" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind Risks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnSpacing="12" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•"/><TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="23"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="☑  Action Items" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ActionStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{x:Bind Tasks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="notes:ActionItemView"><Grid ColumnSpacing="10" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{x:Bind Done, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Text}"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" LineHeight="23" TextDecorations="{x:Bind local:NoteTakerPage.Decorations(Done)}" Foreground="{x:Bind local:NoteTakerPage.TextBrush(Done)}"/><TextBlock Text="{x:Bind Kind}" Style="{StaticResource MutedTextStyle}"/></StackPanel><StackPanel Grid.Column="2" Spacing="6"><Border CornerRadius="4" Background="{StaticResource ChipBrush}" Padding="8,3"><TextBlock Text="{x:Bind DueText}" FontSize="11"/></Border><TextBlock Text="{x:Bind AssigneeText}" FontSize="11"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel></ScrollViewer>
                                </PivotItem>
                                <PivotItem Header="Recording &amp; Transcript">
                                    <ScrollViewer><StackPanel Spacing="16" Padding="0,14,12,20">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Play recording" Tag="{x:Bind AudioPath}" Click="PlayRecording_Click"/><Button Content="Transcribe again" Tag="{x:Bind Id}" Click="TranscribeAgain_Click" IsEnabled="{x:Bind CanTranscribe}"/></StackPanel>
                                        <TextBox Header="Tags (press Enter to save)" Text="{x:Bind Tags}" Tag="{x:Bind Id}" KeyDown="Tags_KeyDown"/>
                                        <ItemsControl ItemsSource="{x:Bind Turns}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="notes:TranscriptTurn"><StackPanel Spacing="8" Margin="0,0,0,22"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Speaker}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind TimeText}" Style="{StaticResource MutedTextStyle}"/></StackPanel><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="25" FontSize="14"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel></ScrollViewer>
                                </PivotItem>
                            </Pivot>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</Page>
