<Page
    x:Class="OpenKrisp.App.Pages.NoteTakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notes="using:OpenKrisp.Core.Notes"
    xmlns:local="using:OpenKrisp.App.Pages">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Note taker" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                     Title="Recording and transcription are not available yet"
                     Message="Action items are added and tracked by hand for now." />
            <InfoBar x:Name="ExtractionInfo" Severity="Informational" IsClosable="False"
                     Title="Automatic action items"
                     Message="{x:Bind Vm.ExtractionStatus}"
                     IsOpen="{x:Bind local:NoteTakerPage.Not(Vm.ExtractionAvailable)}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Action items" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <SelectorBar x:Name="FilterBar" SelectionChanged="FilterBar_SelectionChanged">
                    <SelectorBarItem x:Name="MineItem" Text="Assigned to me" IsSelected="True" />
                    <SelectorBarItem x:Name="AllItem" Text="All action items" />
                </SelectorBar>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewMeetingBox" PlaceholderText="New meeting title" Width="280" KeyDown="NewMeetingBox_KeyDown" />
                <Button Content="Add meeting" Click="AddMeeting_Click" />
            </StackPanel>

            <TextBlock Text="Add a meeting first, then add action items to it."
                       Opacity="0.7"
                       Visibility="{x:Bind local:NoteTakerPage.HiddenWhen(Vm.HasMeetings), Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind Vm.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="notes:MeetingGroup">
                        <StackPanel Spacing="6" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CountText}" Opacity="0.7" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="notes:ActionItemView">
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind Done, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Opacity="0.6" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                    Background="{x:Bind local:NoteTakerPage.DueBackground(IsOverdue)}">
                                                <TextBlock Text="{x:Bind DueText}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{x:Bind AssigneeText}" Opacity="0.7" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Content="Remove" Tag="{x:Bind Id}" Click="Remove_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox PlaceholderText="Add action item…" Tag="{x:Bind Meeting.Id}" KeyDown="AddItemBox_KeyDown" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
