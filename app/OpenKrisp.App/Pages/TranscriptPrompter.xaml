<UserControl x:Class="OpenKrisp.App.Pages.TranscriptPrompter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F8FAFC" CornerRadius="12" RowSpacing="8" Padding="20,12,20,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ToggleButton x:Name="ScrollToggle" Content="Auto-scroll" Click="ScrollToggle_Click" AutomationProperties.Name="Toggle transcript scrolling"/>
                <TextBlock x:Name="ScrollHint" Text="Scroll at your own pace" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="A−" Click="Smaller_Click" AutomationProperties.Name="Smaller transcript text"/>
                <Button Content="A+" Click="Larger_Click" AutomationProperties.Name="Larger transcript text"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Reader" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" Loaded="Reader_Loaded">
            <Grid MaxWidth="880" HorizontalAlignment="Stretch" Padding="12,28,20,0">
                <StackPanel x:Name="Paragraphs" Spacing="28"/>
                <TextBlock x:Name="EmptyMessage" Text="Listening… Your transcript will appear here." FontSize="26" Foreground="#64748B" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
