<Page
    x:Class="OpenKrisp.App.Pages.NoiseCancellationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenKrisp.App.Pages">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="32,8,32,40" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Noise cancellation" Style="{StaticResource PageTitleStyle}" />

            <InfoBar
                Severity="Warning"
                Title="Audio engine unavailable"
                Message="{x:Bind Vm.UnavailableReason}"
                IsOpen="{x:Bind Vm.IsUnavailable}"
                IsClosable="False" />

            <!-- The two switches -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Cancel my noise" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Removes background noise from your microphone." Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Cancel my noise"
                                      IsEnabled="{x:Bind Vm.IsAvailable}"
                                      IsOn="{x:Bind Vm.MyNoiseCancel, Mode=TwoWay}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Cancel others' noise" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Removes background noise from the audio you hear on calls." Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Cancel others' noise"
                                      IsEnabled="{x:Bind Vm.IsAvailable}"
                                      IsOn="{x:Bind Vm.OthersNoiseCancel, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Voice isolation -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Voice isolation" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="IsolationDescription" Style="{StaticResource MutedTextStyle}" />
                    <RadioButtons
                        IsEnabled="{x:Bind Vm.IsAvailable}"
                        SelectedIndex="{x:Bind Vm.VoiceIsolationIndex, Mode=TwoWay}"
                        MaxColumns="2">
                        <x:String>Off</x:String>
                        <x:String>Auto</x:String>
                    </RadioButtons>
                    <InfoBar
                        Severity="Informational"
                        Message="{x:Bind Vm.IsolationNote, Mode=OneWay}"
                        IsOpen="{x:Bind Vm.HasIsolationNote, Mode=OneWay}"
                        IsClosable="False" />
                </StackPanel>
            </Border>

            <!-- Audio routing -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Audio routing" Style="{StaticResource CardTitleStyle}" />

                    <ComboBox Header="Microphone" MinWidth="380"
                              IsEnabled="{x:Bind Routing.IsAvailable}"
                              ItemsSource="{x:Bind Routing.Inputs, Mode=OneWay}" DisplayMemberPath="Display"
                              SelectedItem="{x:Bind Routing.MicInput, Mode=TwoWay}" />

                    <ComboBox Header="Send the cleaned microphone to" MinWidth="380"
                              IsEnabled="{x:Bind Routing.IsAvailable}"
                              SelectedIndex="{x:Bind Routing.MicSinkIndex, Mode=TwoWay}">
                        <x:String>Nowhere (microphone lane off)</x:String>
                        <x:String>OpenKrisp virtual microphone (MicyAudio driver)</x:String>
                        <x:String>A playback device</x:String>
                    </ComboBox>

                    <ComboBox Header="Playback device for the microphone" MinWidth="380"
                              Visibility="{x:Bind local:NoiseCancellationPage.VisibleWhen(Routing.ShowMicSinkDevice), Mode=OneWay}"
                              ItemsSource="{x:Bind Routing.Outputs, Mode=OneWay}" DisplayMemberPath="Display"
                              SelectedItem="{x:Bind Routing.MicSinkDevice, Mode=TwoWay}" />

                    <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />

                    <ComboBox Header="Incoming audio: capture from" MinWidth="380"
                              IsEnabled="{x:Bind Routing.IsAvailable}"
                              ItemsSource="{x:Bind Routing.IncomingSources, Mode=OneWay}" DisplayMemberPath="Display"
                              SelectedItem="{x:Bind Routing.IncomingSource, Mode=TwoWay}" />

                    <ComboBox Header="Play the cleaned incoming audio on" MinWidth="380"
                              IsEnabled="{x:Bind Routing.IsAvailable}"
                              ItemsSource="{x:Bind Routing.Outputs, Mode=OneWay}" DisplayMemberPath="Display"
                              SelectedItem="{x:Bind Routing.IncomingOutput, Mode=TwoWay}" />

                    <TextBlock x:Name="IncomingHelp" Style="{StaticResource MutedTextStyle}" />

                    <Expander Header="Advanced">
                        <ComboBox Header="Sample format written to the virtual microphone driver" MinWidth="380"
                                  SelectedIndex="{x:Bind Routing.MicyFormatIndex, Mode=TwoWay}">
                            <x:String>32-bit integer</x:String>
                            <x:String>32-bit float</x:String>
                            <x:String>16-bit integer</x:String>
                        </ComboBox>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind Routing.CanStart, Mode=OneWay}" Click="Start_Click" />
                        <Button Content="Stop" IsEnabled="{x:Bind Routing.IsRunning, Mode=OneWay}" Click="Stop_Click" />
                        <Button Content="Refresh devices" Click="RefreshDevices_Click" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind Routing.StatusText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{x:Bind Routing.Error, Mode=OneWay}" Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
