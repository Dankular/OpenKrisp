<Application
    x:Class="OpenKrisp.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <!-- Look: light theme only (does not follow the system dark mode), violet accent, soft lavender background,
         white rounded cards, bold navy headings, Inter (bundled, SIL OFL) with Segoe UI as the fallback.
         NOT yet seen rendered by the authors: written from reference images without a Windows machine. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent: everything that uses the system accent (toggles, checkboxes, selector bar, buttons) turns violet. -->
            <Color x:Key="SystemAccentColor">#5B4FE8</Color>
            <Color x:Key="SystemAccentColorDark1">#4D41D6</Color>
            <Color x:Key="SystemAccentColorDark2">#4035B8</Color>
            <Color x:Key="SystemAccentColorDark3">#322A92</Color>
            <Color x:Key="SystemAccentColorLight1">#7A70EE</Color>
            <Color x:Key="SystemAccentColorLight2">#9A92F2</Color>
            <Color x:Key="SystemAccentColorLight3">#C4BFF8</Color>

            <!-- Font: variable Inter shipped next to the exe; falls back to the Windows UI font if it cannot be loaded. -->
            <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter, Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter, Segoe UI Variable, Segoe UI</FontFamily>

            <!-- Palette -->
            <SolidColorBrush x:Key="BrandBrush" Color="#5B4FE8" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#E9E6FD" />
            <SolidColorBrush x:Key="HeadingBrush" Color="#14123A" />
            <SolidColorBrush x:Key="BodyBrush" Color="#25234A" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8A88A6" />
            <SolidColorBrush x:Key="DoneTextBrush" Color="#7C7A94" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#ECE9FA" />
            <SolidColorBrush x:Key="ChipBrush" Color="#EFEFF5" />
            <SolidColorBrush x:Key="ChipOverdueBrush" Color="#FDE3E3" />
            <SolidColorBrush x:Key="RuleBrush" Color="#7FCFD4" />

            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E7E2FE" Offset="0" />
                <GradientStop Color="#F6F4FF" Offset="0.45" />
                <GradientStop Color="#FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- Let the page background show through the tab bar. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#4B4870" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#14123A" />

            <!-- Shared styles -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="28" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
            </Style>

            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>

            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="Foreground" Value="#C62828" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
